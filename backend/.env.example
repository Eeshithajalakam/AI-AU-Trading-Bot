PROJECT_NAME=AI AU Trading Backend
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=change-me-in-production

# FREE-TIER DATABASE: Neon PostgreSQL
# Sign up: https://console.neon.tech
# Replace with your actual Neon connection string
# Format: postgresql://username:password@project-region.neon.tech/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@project-region.neon.tech/trading_db?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0

# FREE-TIER REDIS: Upstash
# Sign up: https://console.upstash.com
# Replace with your actual Upstash Redis URL
# Format: redis://default:password@host:port
REDIS_URL=redis://default:password@host:port
REDIS_MAX_CONNECTIONS=2

BACKEND_CORS_ORIGINS=["https://ai-au-trading-bot.vercel.app"]
RATE_LIMIT_PER_MINUTE=60

# Market data
MARKET_SYMBOL=GC=F
MARKET_INTERVAL=5m

# ML Training - DISABLED FOR FREE TIER
# Uncomment only if you have extended runtime available
# AUTO_TRAIN_ON_STARTUP=true
AUTO_TRAIN_ON_STARTUP=false
PREDICTION_INTERVAL_SECONDS=30

# Trading settings
AUTO_TRADE_ENABLED=false
PAPER_TRADING_MODE=true
MT5_SYMBOL=XAUUSD

# MetaTrader5 credentials (optional)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=

# Trade management
MAX_SPREAD_POINTS=50
TRADE_COOLDOWN_SECONDS=60
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS_USD=500

# Performance optimization for free tier
WORKERS=1
LOG_LEVEL=info
