# Copy to Vercel Environment Variables (frontend)
NEXT_PUBLIC_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
NEXT_PUBLIC_WS_URL=wss://YOUR-RENDER-SERVICE.onrender.com

# Copy to Render Environment Variables (backend) — NEVER commit real passwords
ENVIRONMENT=production
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/trading_db
AUTO_TRAIN_ON_STARTUP=true
AUTO_TRADE_ENABLED=true
PAPER_TRADING_MODE=true
BACKEND_CORS_ORIGINS=["https://YOUR-VERCEL-APP.vercel.app"]
PUBLIC_FRONTEND_URL=https://YOUR-VERCEL-APP.vercel.app
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=MetaQuotes-Demo
